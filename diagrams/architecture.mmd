%% TuneScout RAG: system architecture
%% Extends the Module 3 Music Recommender (src/recommender.py) with
%% retrieval-augmented generation, an optional agent mode, and testing.
%% Flow is top-to-bottom: request -> guardrails -> retrieval -> Gemini -> answer.

flowchart TD
    U([Listener types a request<br/>e.g. 'mellow songs for studying'])

    subgraph SOURCES["① Knowledge sources (indexed at startup)"]
        direction LR
        CSV[(data/songs.csv<br/>20 songs)] --> IDX[(TF-IDF index)]
        KB[(data/knowledge/<br/>mood & genre guides)] --> IDX
    end

    subgraph RAG["② RAG pipeline (default): src/rag.py"]
        VAL{Input guardrail<br/>empty / too long?}
        RET[Retriever<br/>match guides → expand query<br/>→ top 8 songs]
        THR{Relevance guardrail<br/>score ≥ threshold?}
        GEN[Gemini<br/>few-shot prompt with ONLY<br/>retrieved songs + guide notes]
        OUTG{Output guardrail<br/>drop ids not retrieved}
        VAL -->|ok| RET --> THR -->|yes| GEN --> OUTG
    end

    subgraph AGENT["③ Agent mode (--agent): src/agent.py"]
        PLAN[Gemini planner<br/>moods to avoid, energy range]
        TOOLS[Python tools<br/>search · lookup · constraints]
        AGEN[Gemini recommender]
        ACHK{Plan check}
        PLAN --> TOOLS --> AGEN --> ACHK
        ACHK -->|violation: retry once| AGEN
    end

    U --> VAL
    VAL -->|--agent| PLAN
    IDX --> RET
    IDX --> TOOLS

    MSG[Helpful message<br/>LLM never called]
    FB[Fallback: Module 3<br/>rule-based scorer]
    ANS[Recommendations<br/>+ reasons + song ids]
    VAL -->|invalid| MSG
    THR -->|no| MSG
    GEN -->|API error / no key| FB
    OUTG --> ANS
    ACHK -->|ok| ANS
    FB --> ANS

    subgraph CHECKS["④ Human & testing checks"]
        HUMAN[Human review<br/>listener checks cited songs<br/>edits songs / guides]
        TESTS[pytest: 43 tests<br/>+ 4 known-limit xfails]
        EVAL[Evaluation harness<br/>src/evaluate.py]
        LOG[(Logs & agent traces<br/>reviewed by developer)]
    end

    ANS --> HUMAN
    TESTS -.->|verify guardrails,<br/>retrieval, agent| RAG
    EVAL -.->|pass/fail reports| AGENT
    RAG -.-> LOG

    classDef human fill:#fde68a,stroke:#b45309,color:#000
    classDef guard fill:#fecaca,stroke:#b91c1c,color:#000
    classDef store fill:#bfdbfe,stroke:#1d4ed8,color:#000
    classDef legacy fill:#d1fae5,stroke:#047857,color:#000
    class U,HUMAN human
    class VAL,THR,OUTG,ACHK guard
    class CSV,KB,IDX,LOG store
    class FB legacy
